{
  "name": "PokeDoc — Comunidad Pokémon TCG",
  "short_name": "PokeDoc",
  "description": "Guías, foro y comunidad en español sobre el JCC Pokémon: aprende a detectar falsificaciones, colecciona y juega.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1e5175",
  "theme_color": "#1e5175",
  "icons": [
    {
      "src": "/assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/app-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Añadir a mi colección",
      "short_name": "Añadir",
      "description": "Busca una carta y añádela",
      "url": "/mi-coleccion?ver=buscar",
      "icons": [
        {
          "src": "/assets/atajos/anadir.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mensajes",
      "short_name": "Mensajes",
      "description": "Tus conversaciones y tus tratos",
      "url": "/mensajes",
      "icons": [
        {
          "src": "/assets/atajos/mensajes.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Retos",
      "short_name": "Retos",
      "description": "Los retos de hoy, con tu racha",
      "url": "/retos",
      "icons": [
        {
          "src": "/assets/atajos/retos.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "La quiero",
      "short_name": "La quiero",
      "description": "Las cartas que buscas, con su precio",
      "url": "/mi-coleccion?ver=quiero",
      "icons": [
        {
          "src": "/assets/atajos/la-quiero.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "id": "/",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "categories": [
    "games",
    "entertainment",
    "social"
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "foto",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
